<!DOCTYPE html>
<html lang="my">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PT & AI Studio</title>

<style>
*{
   ;
  margin:0;
  padding:0;
}

body{
  background:#020617;
  color:white;
  font-family:Arial,"Noto Sans Myanmar",sans-serif;
  min-height:100vh;
}

.app{
  width:100%;
  max-width:1100px;
  margin:auto;
  padding:18px;
  padding-bottom:100px;
}

/* TOP */
.top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  height:90px;
}

.menu{
  font-size:38px;
  color:#9b8cff;
  cursor:pointer;
}

.logo{
  text-align:center;
  flex:1;
}

.logo h1{
  font-size:42px;
  font-weight:900;
  background:linear-gradient(90deg,#00eaff,#b300ff,#ff4df5);
  -webkit-background-clip:text;
  color:transparent;
  text-shadow:0 0 25px #7c3cff;
}

.logo p{
  font-size:18px;
  margin-top:3px;
}

.vip{
  font-size:28px;
  color:#ffd21c;
}

/* SEARCH */
.search{
  margin-top:15px;
  height:70px;
  border:3px solid #00eaff;
  border-right-color:#ff22e6;
  border-radius:40px;
  display:flex;
  align-items:center;
  padding:8px 12px 8px 22px;
  box-shadow:0 0 18px #00eaff55,0 0 18px #ff00e655;
}

.search span{
  flex:1;
  font-size:20px;
  color:#eee;
}

.search button{
  width:54px;
  height:54px;
  border:0;
  border-radius:50%;
  background:linear-gradient(135deg,#b000ff,#ff21d8);
  color:white;
  font-size:30px;
}

/* CATEGORIES */
.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin:18px 0;
}

.cat{
  border:2px solid #244ea8;
  border-radius:30px;
  padding:12px 10px;
  text-align:center;
  font-size:17px;
  background:#07102d;
  box-shadow:0 0 10px #1445a855;
}

/* TOOLS */
.tools{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.card{
  min-height:190px;
  border-radius:25px;
  padding:22px;
  position:relative;
  overflow:hidden;
  border:3px solid;
  cursor:pointer;
  transition:.25s;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 0 25px #ffffff44;
}

.card .icon{
  width:58px;
  height:58px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:17px;
  background:#ffffff22;
  font-size:31px;
  margin-bottom:15px;
}

.card h2{
  font-size:23px;
  margin-bottom:7px;
}

.card p{
  font-size:16px;
  line-height:1.5;
  opacity:.9;
}

.arrow{
  position:absolute;
  right:18px;
  bottom:18px;
  width:48px;
  height:48px;
  border-radius:50%;
  display:flex;
  justify-content:center;
  align-items:center;
  background:#ffffff22;
  font-size:27px;
}

/* COLORS */
.blue{
  background:linear-gradient(135deg,#0735a9,#00b9ff33);
  border-color:#00d9ff;
}

.pink{
  background:linear-gradient(135deg,#7300bd,#ff20e433);
  border-color:#ff3bea;
}

.orange{
  background:linear-gradient(135deg,#a94e00,#ffb30044);
  border-color:#ffb51b;
}

.green{
  background:linear-gradient(135deg,#006b58,#00d9a044);
  border-color:#22f5bd;
}

.purple{
  background:linear-gradient(135deg,#4d00a5,#c400ff44);
  border-color:#d536ff;
}

.cyan{
  background:linear-gradient(135deg,#005da8,#00d9ff44);
  border-color:#00cfff;
}

/* PROJECTS */
.section-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:28px 5px 14px;
}

.section-title h2{
  font-size:22px;
}

.more{
  border:2px solid #4262bd;
  border-radius:25px;
  padding:8px 16px;
  background:#07102d;
  color:white;
}

/* PROJECT LIST */
.projects{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
}

.project{
  background:#07102d;
  border-radius:15px;
  overflow:hidden;
  border:1px solid #263d76;
}

.project-img{
  height:125px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:48px;
  background:linear-gradient(135deg,#ff7043,#172554,#7c3aed);
}

.project:nth-child(2) .project-img{
  background:linear-gradient(135deg,#8b5cf6,#0f172a,#ec4899);
}

.project:nth-child(3) .project-img{
  background:linear-gradient(135deg,#60a5fa,#312e81,#f0abfc);
}

.project:nth-child(4) .project-img{
  background:linear-gradient(135deg,#64748b,#0f172a,#22d3ee);
}

.project:nth-child(5) .project-img{
  background:linear-gradient(135deg,#f59e0b,#334155,#38bdf8);
}

.project-info{
  padding:9px;
}

.project-info h3{
  font-size:15px;
  margin-bottom:6px;
}

.project-info small{
  color:#b8c4e5;
}

/* BOTTOM NAV */
.bottom{
  position:fixed;
  left:50%;
  bottom:0;
  transform:translateX(-50%);
  width:100%;
  max-width:1100px;
  height:82px;
  background:#030a24ee;
  backdrop-filter:blur(12px);
  border:2px solid #1553a5;
  border-bottom:0;
  border-radius:35px 35px 0 0;
  display:flex;
  justify-content:space-around;
  align-items:center;
  z-index:20;
}

.nav{
  text-align:center;
  color:#c9c8ff;
  font-size:13px;
}

.nav-icon{
  font-size:28px;
  margin-bottom:4px;
}

.add{
  width:72px;
  height:72px;
  margin-top:-30px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:48px;
  background:linear-gradient(135deg,#00eaff,#ff00e6);
  box-shadow:0 0 25px #b400ff;
  border:5px solid #fff;
}

/* MOBILE */
@media(max-width:700px){

  .app{
    padding:10px;
    padding-bottom:95px;
  }

  .top{
    height:85px;
  }

  .logo h1{
    font-size:27px;
  }

  .logo p{
    font-size:13px;
  }

  .menu{
    font-size:30px;
  }

  .vip{
    font-size:22px;
  }

  .search{
    height:62px;
  }

  .search span{
    font-size:16px;
  }

  .search button{
    width:48px;
    height:48px;
    font-size:25px;
  }

  .categories{
    grid-template-columns:repeat(4,1fr);
    gap:7px;
  }

  .cat{
    font-size:12px;
    padding:10px 3px;
  }

  .tools{
    gap:12px;
  }

  .card{
    min-height:180px;
    padding:15px;
    border-radius:22px;
  }

  .card .icon{
    width:48px;
    height:48px;
    font-size:25px;
  }

  .card h2{
    font-size:17px;
  }

  .card p{
    font-size:13px;
  }

  .arrow{
    width:40px;
    height:40px;
    font-size:22px;
  }

  .projects{
    grid-template-columns:repeat(5,1fr);
    gap:6px;
    overflow:hidden;
  }

  .project-img{
    height:75px;
    font-size:28px;
  }

  .project-info{
    padding:6px;
  }

  .project-info h3{
    font-size:10px;
  }

  .project-info small{
    font-size:8px;
  }

  .bottom{
    height:72px;
  }

  .nav-icon{
    font-size:23px;
  }

  .nav{
    font-size:10px;
  }

  .add{
    width:62px;
    height:62px;
    font-size:40px;
  }
}
</style>
</head>

<body>

